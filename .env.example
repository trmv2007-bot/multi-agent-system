# Multi-Agent System Environment Variables
# Copy this file to .env and fill in your values

# LLM Provider (keypool, local, openai, anthropic, google)
LLM_PROVIDER=keypool

# KeyPool Gateway (all AI calls route through here)
# ENABLE_FREE_FALLBACK=false keeps every call on KeyPool; true adds the other
# configured providers below as fallbacks when KeyPool is rate limited.
ENABLE_FREE_FALLBACK=false
KEYPOOL_BASE_URL=http://127.0.0.1:8787
KEYPOOL_API_KEY=kp_your_keypool_key_here
KEYPOOL_MODEL=pooled-model
KEYPOOL_PROTOCOL=anthropic_messages

# Local LLM (Ollama, LM Studio, LocalAI) - set LLM_PROVIDER=local to use
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=llama3.2

# Free fallback providers (add keys to expand the failover chain)
OPENROUTER_API_KEY=sk-or-v1-...       # https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=openrouter/free

GROQ_API_KEY=gsk_...                  # https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FREE_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=AI...                  # https://aistudio.google.com/app/apikey
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_FREE_MODEL=gemini-1.5-flash

CLOUDFLARE_API_KEY=...                # https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_FREE_MODEL=@hf/meta-llama/llama-3.2-3b-instruct

# OpenAI (fallback only)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3.5-sonnet-20241022

# Google (direct, not via router)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-flash

# Run state. Defaults to a local SQLite file so threads remember earlier runs.
# Set CHECKPOINT_DB= (empty) to keep everything in memory only.
CHECKPOINT_DB=multi-agent.sqlite

# Postgres instead of SQLite (requires: pip install -e ".[postgres]")
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multiagent

# LangSmith (for tracing)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=multi-agent-system
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# OpenTelemetry (off by default; set OTEL_ENABLED=true to export to a collector)
# Local speech-to-text (no key, audio never leaves the machine)
# Models: base, small, distil-small.en, medium, large-v3
WHISPER_MODEL=medium
WHISPER_LANGUAGE=en
# auto uses the GPU when one is present, and falls back to CPU
WHISPER_DEVICE=auto

# Thinking power per call: off, low, medium, high, max
# Sends reasoning_effort plus a matching max_tokens cap to the gateway.
THINKING_LEVEL=medium

# Retries: model calls walk the provider chain with exponential backoff
LLM_TIMEOUT_SECONDS=120
MAX_FALLBACK_RETRIES=4
LLM_RETRY_BACKOFF=3
TOOL_RETRIES=2

OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=multi-agent-system

# GitHub (optional: raises the search_github rate limit, enables code search)
# GITHUB_TOKEN=ghp_...

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# MCP Server (loopback by default; a network bind needs SERVER_AUTH_TOKEN)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# A2A Server (same rule)
A2A_SERVER_HOST=127.0.0.1
A2A_SERVER_PORT=8002

# Bearer token the MCP and A2A HTTP servers require on every request.
# Required before either server will start on a non-loopback host.
# SERVER_AUTH_TOKEN=<long-random-string>

# Live cursor overlay (also on with --cursor; --no-cursor turns it off)
CURSOR_OVERLAY=false
CURSOR_SETTLE_MS=150
CURSOR_GLIDE_MS=200

# Answer every model call from the scripted provider in src/demo.py, so the
# dashboard and the CLI run with no key at all. multi-agent-demo sets this for you.
# DEMO_MODE=false

# Application
LOG_LEVEL=INFO
MAX_PARALLEL_AGENTS=5
THREAD_ID=default-session